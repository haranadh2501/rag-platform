    {
      "parameters": {
        "operation": "executeQuery",
        "query": "{{ (() => {\n    const raw = String($json.embedding || '');\n    const emb = raw.replace(/^=\\s*/, '').trim();\n    const content = String($json.content || '').replace(/'/g, \"''\");\n    return `INSERT INTO document_chunks (tenant_id, document_id, content, embedding, chunk_index, page_number, token_count, metadata) VALUES ('${$json.tenant_id}', '${$json.document_id}',\n  '${content}', '${emb}'::vector, ${Number($json.chunk_index)}, NULL, ${Number($json.token_count)}, '{}'::jsonb)`;\n  })() }}",
        "options": {}
      },
