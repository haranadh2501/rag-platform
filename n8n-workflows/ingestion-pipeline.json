      "id": "51f3728e-f955-42a2-9809-c6237e1e7800",
      "name": "Fetch URL",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        0,
        0
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst { source_type, file_path } = item;\nlet text = '';\nlet page_count = 1;\n\nif (source_type === 'txt') {\n  const fs = require('fs');\n  text = fs.readFileSync(file_path, 'utf-8');\n\n} else if (source_type === 'pdf') {\n  try {\n    const pdfParse = require('pdf-parse');\n    const fs = require('fs');\n    const buf = fs.readFileSync(file_path);\n    const data = await pdfParse(buf);\n    text = data.text || '';\n    page_count = data.numpages || 1;\n  } catch(e) {\n    text = '';\n  }\n\n} else if (source_type === 'docx') {\n  try {\n    const mammoth = require('mammoth');\n    const result = await mammoth.extractRawText({ path: file_path });\n    text = result.value || '';\n  } catch(e) {\n    const fs = require('fs');\n    const buf = fs.readFileSync(file_path);\n    text = buf.toString('latin1').replace(/<[^>]+>/g, ' ').replace(/\\s+/g, ' ').trim();\n  }\n}\n\nreturn [{\n  json: {\n    document_id: item.document_id,\n    tenant_id:   item.tenant_id,\n    title:       item.title,\n    file_path:   item.file_path,\n    source_type,\n    text,\n    page_count,\n    used_ocr:    false\n  }\n}];"
      },
      "id": "bb4b372e-696c-4f43-a5d4-6f83efe13a68",
      "name": "Extract File Text",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        0,
