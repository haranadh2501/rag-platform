        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {\"model\": \"voyage-4-large\", \"input\": [$json.content], \"input_type\": \"document\"} }}",
