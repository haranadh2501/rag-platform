    {
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/chat/completions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.OPENAI_API_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"gpt-4o-mini\",\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": [\n        { \"type\": \"text\", \"text\": \"Extract ALL text verbatim from this document. Return only the raw text.\" },\n        { \"type\": \"image_url\", \"image_url\": { \"url\": \"data:image/jpeg;base64,{{ require('fs').readFileSync($json.file_path).toString('base64') }}\", \"detail\": \"high\" } }\n      ]\n    }\n  ],\n  \"max_tokens\": 4096\n}",
        "options": {
          "timeout": 120000
        }
      },
      "id": "c501bb9d-9bce-47ff-8936-c1a1d15f0d00",
      "name": "OpenAI Vision OCR",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        48
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "const ocrResp = $input.first().json;\nconst orig = $('IF: Needs OCR').first().json;\nconst ocrText = ocrResp.choices?.[0]?.message?.content || '';\nreturn [{\n  json: {\n    document_id: orig.document_id,\n    tenant_id:   orig.tenant_id,\n    title:       orig.title,\n    file_path:   orig.file_path,\n    source_type: orig.source_type,\n    text:        ocrText,\n    page_count:  orig.page_count || 1,\n    used_ocr:    true\n  }\n}];"
      },
      "id": "37c13b5e-e8fc-4cb9-ab16-c3e0a363091e",
      "name": "Parse OCR Response",
