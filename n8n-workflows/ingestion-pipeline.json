              "id": "44004430-90ae-4799-a14e-ea5d33c674b6",
              "name": "chunks",
              "value": "={{ (() => { const words = $json.text.split(/\\s+/).filter(w => w.length > 0); const CHUNK_WORDS = 512; const OVERLAP_WORDS = 50; const chunks = []; let i = 0; while (i < words.length) {\n  const slice = words.slice(i, i + CHUNK_WORDS); const content = slice.join(' '); chunks.push({ content, chunk_index: chunks.length, page_number: null, token_count: Math.ceil(content.length\n  / 4) }); if (i + CHUNK_WORDS >= words.length) break; i += CHUNK_WORDS - OVERLAP_WORDS; } if (chunks.length === 0) chunks.push({ content: $json.text, chunk_index: 0, page_number: null,\n  token_count: Math.ceil($json.text.length / 4) }); return chunks; })() }}",
