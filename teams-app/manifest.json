{
  "$schema": "https://developer.microsoft.com/en-us/json-schemas/teams/v1.16/MicrosoftTeams.schema.json",
  "manifestVersion": "1.16",
  "version": "1.0.0",
  "id": "REPLACE_WITH_MICROSOFT_APP_ID",
  "packageName": "ai.iisc.ragplatform.teams",
  "developer": {
    "name": "IISc RAG Platform",
    "websiteUrl": "https://example.com",
    "privacyUrl": "https://example.com/privacy",
    "termsOfUseUrl": "https://example.com/terms"
  },
  "name": {
    "short": "RAG Assistant",
    "full": "IISc Grounded RAG Assistant"
  },
  "description": {
    "short": "Ask grounded questions over your onboarded documents.",
    "full": "A grounded, multi-tenant RAG assistant. Ask questions and upload files to get cited answers from your organization's knowledge base. Send /new, /reset, or /clear to start a fresh conversation."
  },
  "icons": {
    "color": "color.png",
    "outline": "outline.png"
  },
  "accentColor": "#2A5DB0",
  "bots": [
    {
      "botId": "REPLACE_WITH_MICROSOFT_APP_ID",
      "scopes": ["personal", "team", "groupchat"],
      "supportsFiles": true,
      "isNotificationOnly": false
    }
  ],
  "permissions": ["identity", "messageTeamMembers"],
  "validDomains": []
}
